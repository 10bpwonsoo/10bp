# 데이터 (주간 생성물 — 사내 데이터이므로 커밋하지 않는다)
data/raw/*
data/processed/*
data/archive/*
data/reference/*
!data/**/.gitkeep

# 로그
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# Streamlit 로컬 설정
.streamlit/secrets.toml

# 오프라인 설치용 wheel (용량이 크고 플랫폼별로 다르다)
wheelhouse/

# 업데이트 도구(src/updater.py)가 설치본에 남기는 것
.pm_version.json
*.new
*.bak
