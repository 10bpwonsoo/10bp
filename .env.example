# Telegram Bot Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ─────────────────────────────────────────────────────────
# Market Pulse AI
# ─────────────────────────────────────────────────────────
# 데이터 모드: MOCK | DELAYED | LIVE  (기본 MOCK)
MARKETPULSE_DATA_MODE=MOCK
# MOCK 모드에서 사용할 시나리오 이름 (marketpulse/data/mock/scenario_*.json)
MARKETPULSE_SCENARIO=baseline
# LLM 사용 여부. false 이면 정량 파이프라인만 동작한다.
MARKETPULSE_LLM_ENABLED=false
# LLM 키는 절대 코드에 넣지 않는다. 환경변수로만 주입한다.
ANTHROPIC_API_KEY=
