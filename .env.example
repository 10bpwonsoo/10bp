# 이 파일을 .env 로 복사해서 채운다. .env 는 .gitignore 에 있다.
#   cp .env.example .env
#
# API 키와 시크릿은 절대 소스 파일에 넣지 않는다. 전부 여기서 읽는다.

# ─────────────────────────────────────────────────────────
# Market Pulse AI
# ─────────────────────────────────────────────────────────
# 데이터 모드: MOCK | DELAYED | LIVE  (기본 MOCK)
#   MOCK    결정론적 시나리오. 네트워크를 쓰지 않는다.
#   DELAYED 무료 공급자의 일봉 종가 + RSS.
#   LIVE    같은 데이터를 쓰되 "실시간을 요구했다" 는 경고가 화면에 남는다.
#           무료 공급자로는 장중 틱을 받을 수 없다.
# 무엇이 되고 무엇이 왜 안 되는지 확인:
#   python -m marketpulse.cli probe --mode DELAYED
MARKETPULSE_DATA_MODE=MOCK
# LIVE/DELAYED 어댑터의 HTTP 타임아웃(초). 공급자 하나가 느리다고
# 전체 틱이 늘어지면 안 된다.
MARKETPULSE_HTTP_TIMEOUT_SEC=8
# 실데이터에서 받을 기사 수
MARKETPULSE_NEWS_LIMIT=60
# MOCK 모드에서 재생할 시나리오 (marketpulse/data/mock/scenario_*.json)
MARKETPULSE_SCENARIO=baseline
# false 이면 정량 파이프라인만 동작한다. LLM 장애와 같은 경로다.
MARKETPULSE_LLM_ENABLED=false
# LLM 을 켤 때만 필요하다.
ANTHROPIC_API_KEY=
# 이벤트 추출·요약에 쓸 모델
MARKETPULSE_LLM_MODEL=claude-opus-5

# 금리·크레딧·기대인플레이션의 정본은 FRED 다. 키가 없으면 해당 종목은
# Yahoo 로 떨어지고, 그것도 안 되면 missing 으로 남는다 — 다른 값으로
# 조용히 채우지 않는다. 무료 발급: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ─────────────────────────────────────────────────────────
# Upbit Trading Bot
# ─────────────────────────────────────────────────────────
# upbit_trading/config.py 가 읽는 변수들이다.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# SQL Server 접속. trusted_connection 을 쓰면 username/password 는 비워둔다.
DB_SERVER=YOUR-HOST\SQLEXPRESS
DB_NAME=CryptoDB
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_USERNAME=
DB_PASSWORD=

# 텔레그램 알림
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# 로그 레벨: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
